      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst count = d => rows.filter(r => r.decision === d).length;\n\nconst excludedByReason = {};\nfor (const r of rows.filter(r => r.decision === 'excluded')) {\n  const key = r.reason.startsWith('emailed') ? 'frequency cap' : r.reason;\n  excludedByReason[key] = (excludedByReason[key] || 0) + 1;\n}\n\nreturn [{ json: {\n  campaign_id: rows[0]?.campaign_id,\n  total: rows.length,\n  send: count('send'),\n  holdout: count('holdout'),\n  excluded: count('excluded'),\n  excluded_by_reason: excludedByReason,\n}}];"
      },
