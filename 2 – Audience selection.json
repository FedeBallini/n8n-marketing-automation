    {
      "parameters": {
        "jsCode": "// ---------- Settings ----------\nconst FREQUENCY_CAP_DAYS = 7;\nconst HOLDOUT_PERCENT = 10;\nconst FALLBACK_LANGUAGE = 'en';\n\nconst campaign = $('Pick campaign').first().json;\nconst targets  = campaign.target_stages;                       // e.g. ['lead', 'mql']\nconst contacts = $('Get contacts').all().map(i => i.json);\nconst copyRows = $('Get copy').all().map(i => i.json)\n  .filter(r => String(r.campaign_id) === String(campaign.campaign_id));\n\n// ---------- Helpers ----------\nconst yes = v => v === true || String(v).trim().toUpperCase() === 'TRUE';\nconst now = new Date();\n\nfunction parseDate(v) {\n  if (v === undefined || v === null || v === '') return null;\n  if (typeof v === 'number') return new Date(Date.UTC(1899, 11, 30) + v * 86400000); // Sheets serial date\n  const s = String(v).trim();\n  let m = s.match(/^(\\d{4})-(\\d{2})-(\\d{2})/);                // 2026-08-14\n  if (m) return new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));\n  m = s.match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/);              // 14/08/2026\n  if (m) return new Date(Date.UTC(+m[3], +m[2] - 1, +m[1]));\n  return null;\n}\nconst daysSince = d => Math.floor((now - d) / 86400000);\n\n// Same contact + same campaign always lands in the same group, so re-runs are consistent\nfunction bucket(s) {\n  let h = 0;\n  for (const ch of s) h = (h * 31 + ch.charCodeAt(0)) >>> 0;\n  return h % 100;\n}\n\n// Approved copy, looked up by \"segment|language\"\nconst copy = {};\nfor (const r of copyRows) copy[`${r.segment}|${r.language}`] = r;\n\n// ---------- Rules ----------\nconst seen = new Set();\nconst out = [];\n\nfor (const c of contacts) {\n  const email   = String(c.email || '').trim().toLowerCase();\n  const segment = String(c.segment || '').trim().toLowerCase();\n  const lang    = String(c.language || '').trim().toLowerCase();\n  const stage   = String(c.lifecycle_stage || '').trim().toLowerCase();\n  const last    = parseDate(c.last_emailed_at);\n\n  let reason = null;\n  if (!email.includes('@'))                                      reason = 'invalid email';\n  else if (seen.has(email))                                      reason = 'duplicate';\n  else if (yes(c.unsubscribed))                                  reason = 'unsubscribed';\n  else if (yes(c.bounced))                                       reason = 'bounced';\n  else if (!yes(c.opted_in))                                     reason = 'no opt-in';\n  else if (yes(c.is_customer) && !targets.includes('customer'))  reason = 'existing customer';\n  else if (!targets.includes(stage))                             reason = `stage '${stage}' not targeted`;\n  else if (last && daysSince(last) < FREQUENCY_CAP_DAYS)         reason = `emailed ${daysSince(last)} days ago (${FREQUENCY_CAP_DAYS}-day cap)`;\n  seen.add(email);\n\n  // Language: contact's own language if copy exists, otherwise fallback\n  let sendLang = lang;\n  let variant = copy[`${segment}|${lang}`];\n  if (!reason && !variant) { sendLang = FALLBACK_LANGUAGE; variant = copy[`${segment}|${FALLBACK_LANGUAGE}`]; }\n  if (!reason && !variant) reason = 'no approved copy for this segment';\n\n  let decision = reason ? 'excluded' : 'send';\n  if (decision === 'send' && bucket(email + campaign.campaign_id) < HOLDOUT_PERCENT) {\n    decision = 'holdout';\n    reason = `control group (${HOLDOUT_PERCENT}%)`;\n  }\n\n  out.push({ json: {\n    campaign_id: campaign.campaign_id,\n    email,\n    first_name: c.first_name,\n    segment,\n    language: lang || '(none)',\n    send_language: decision === 'excluded' ? '' : sendLang,\n    decision,\n    reason: reason || '',\n    logged_at: now.toISOString(),\n    row_number: c.row_number,\n    subject: variant?.subject,\n    headline: variant?.headline,\n    body: variant?.body,\n    cta_label: variant?.cta_label,\n    cta_url: variant?.cta_url,\n  }});\n}\n\nreturn out;"
      },
