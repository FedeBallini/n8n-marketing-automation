        "jsCode": "const rows = $('Select audience').all().map(i => i.json);\nconst c = $('Pick campaign').first().json;\nconst count = d => rows.filter(r => r.decision === d).length;\n\nconst reasons = {};\nfor (const r of rows.filter(r => r.decision === 'excluded')) {\n  const key = r.reason.startsWith('emailed') ? 'frequency cap' : r.reason;\n  reasons[key] = (reasons[key] || 0) + 1;\n}\nconst reasonLines = Object.entries(reasons).map(([k, v]) => `${k}: ${v}`).join('<br>');\n\nconst html = `<h3>${c.campaign_name}</h3>\n<p>Sent: <b>${count('send')}</b> · Holdout (control group): <b>${count('holdout')}</b> · Excluded: <b>${count('excluded')}</b></p>\n<p><b>Excluded by reason</b><br>${reasonLines}</p>\n<p>Full audit trail: audience_log tab.</p>`;\n\nreturn [{ json: { subject: `Sent: ${c.campaign_name}`, html } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
