      "parameters": {
        "jsCode": "const rows = $('All variants').all().map(i => i.json);\nconst c = $('Campaign setup').first().json;\nconst esc = s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\n\nconst tr = rows.map(r => `<tr>\n  <td>${r.segment}<br>${r.language}${r.rewritten ? '<br><b>REWRITTEN</b>' : ''}</td>\n  <td><b>${esc(r.subject)}</b><br><i>${esc(r.headline)}</i><br><br>${esc(r.body)}<br><br>[${esc(r.cta_label)}]</td>\n  <td>${r.review_score}/5<br>${esc(r.issues)}</td>\n</tr>`).join('');\n\nconst html = `<p><b>${esc(c.campaign_name)}</b>: ${rows.length} variants, ${rows.filter(r => r.rewritten).length} rewritten.</p>\n<table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse;font-family:sans-serif;font-size:13px\">\n<tr><th>Audience</th><th>Copy</th><th>Review</th></tr>${tr}</table>`;\n\nreturn [{ json: { html } }];"
      },
