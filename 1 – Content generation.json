      "id": "fc4b91fd-4db3-425b-860d-8b96aaeee23b",
      "name": "Campaign setup"
    },
    {
      "parameters": {
        "jsCode": "const c = $input.first().json;\n\nconst segments = {\n  marketer:  'Marketing managers. Care about pipeline, campaign results and saving time. Not technical.',\n  developer: 'Developers and technical builders. Care about control, APIs and not being slowed down. Allergic to hype.',\n  ops:       'Operations and RevOps people. Care about reliability, fewer manual steps and clean data.',\n};\n\nconst languages = {\n  en: { name: 'English',                                 address: 'Direct \"you\"' },\n  it: { name: 'Italian',                                 address: 'Informal \"tu\"' },\n};\n\nconst out = [];\nfor (const [segment, segment_description] of Object.entries(segments)) {\n  for (const [language, l] of Object.entries(languages)) {\n    out.push({ json: { ...c, segment, segment_description, language,\n                       language_name: l.name, address_form: l.address } });\n  }\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        0
      ],
      "id": "ef1c919d-53d3-444b-8e64-01baaee66200",
      "name": "Build variants"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a senior email copywriter.\n\nBRAND VOICE GUIDE\n{{ $json.brand_voice }}\n\nCAMPAIGN BRIEF\n- Goal: {{ $json.goal }}\n- Topic: {{ $json.topic }}\n- Key points: {{ $json.key_points }}\n\nAUDIENCE\n- Segment: {{ $json.segment }}: {{ $json.segment_description }}\n- Language: {{ $json.language_name }}\n- Form of address: {{ $json.address_form }}\n\nTASK\nWrite one marketing email for this audience. Write it natively in {{ $json.language_name }}. Do not translate from English: use expressions and examples that feel natural to this reader. Angle the message to what this segment cares about.\n\nRULES\n- subject: max 55 characters, no emoji, no exclamation marks\n- headline: max 70 characters\n- body: 60-110 words, plain text, ONE paragraph, no line breaks, no greeting line, no sign-off\n- cta_label: 2-4 words, starts with a verb\n- Never include URLs, prices or claims that are not in the brief\n- Never use these words or their translations: {{ $json.banned_words }}",
        "hasOutputParser": true,
        "batching": {
          "batchSize": 1,
          "delayBetweenBatches": 10000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        176,
        0
      ],
      "id": "100b4807-7d27-4cb1-8095-2f3efc5738b3",
      "name": "Write email",
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "temperature": 0.7
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        176,
        176
      ],
      "id": "fada8d42-d419-4042-af75-abd365ef1df3",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "fOvcobDsYNTsM5ii",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"subject\":   { \"type\": \"string\" },\n    \"headline\":  { \"type\": \"string\" },\n    \"body\":      { \"type\": \"string\" },\n    \"cta_label\": { \"type\": \"string\" }\n  },\n  \"required\": [\"subject\", \"headline\", \"body\", \"cta_label\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        320,
        176
      ],
      "id": "366970e7-0d8f-44c3-8cd8-803ec9638c65",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const variants = $('Build variants').all();\n\nreturn $input.all().map((item, i) => {\n  const v = variants[i].json;\n  const copy = item.json.output;\n  const issues = [];\n\n  if (copy.subject.length > 55)  issues.push(`Subject too long (${copy.subject.length} chars)`);\n  if (copy.subject.includes('!')) issues.push('Exclamation mark in subject');\n  if (copy.headline.length > 70) issues.push(`Headline too long (${copy.headline.length} chars)`);\n\n  const words = copy.body.trim().split(/\\s+/).length;\n  if (words < 60 || words > 110) issues.push(`Body is ${words} words (target 60-110)`);\n  if (/https?:\\/\\/|www\\./i.test(copy.body)) issues.push('Body contains a URL');\n\n  const text = `${copy.subject} ${copy.headline} ${copy.body}`.toLowerCase();\n  const found = v.banned_words.split(',').map(w => w.trim().toLowerCase())\n                 .filter(w => w && text.includes(w));\n  if (found.length) issues.push(`Banned words: ${found.join(', ')}`);\n\n  return { json: {\n    campaign_id: v.campaign_id,\n    segment: v.segment,\n    language: v.language,\n    language_name: v.language_name,\n    address_form: v.address_form,\n    segment_description: v.segment_description,\n    subject: copy.subject,\n    headline: copy.headline,\n    body: copy.body,\n    cta_label: copy.cta_label,\n    cta_url: v.cta_url,\n    hard_issues: issues,\n  }};\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
