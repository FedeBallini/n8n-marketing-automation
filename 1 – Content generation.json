    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"pass\":   { \"type\": \"boolean\" },\n    \"score\":  { \"type\": \"integer\" },\n    \"issues\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n  },\n  \"required\": [\"pass\", \"score\", \"issues\"]\n}"
