      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const failed = $('Passed?').all(1);   // items from the \"false\" output\n\nreturn $input.all().map((item, i) => ({ json: {\n  ...failed[i].json,\n  ...item.json.output,\n  rewritten: true,\n  issues: 'Rewritten after: ' + failed[i].json.issues,\n}}));"
      },
