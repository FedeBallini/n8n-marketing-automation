    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a senior email copywriter. An editor rejected this email. Rewrite it so every problem below is fixed, keeping what already works.\n\nPROBLEMS TO FIX\n{{ $json.issues }}\n\nORIGINAL EMAIL\nSubject: {{ $json.subject }}\nHeadline: {{ $json.headline }}\nBody: {{ $json.body }}\nCTA: {{ $json.cta_label }}\n\nBRAND VOICE GUIDE\n{{ $('Campaign setup').first().json.brand_voice }}\n\nBRIEF\n- Topic: {{ $('Campaign setup').first().json.topic }}\n- Key points: {{ $('Campaign setup').first().json.key_points }}\n\nAUDIENCE\n- Segment: {{ $json.segment }}: {{ $json.segment_description }}\n- Language: {{ $json.language_name }}, form of address: {{ $json.address_form }}\n\nRULES\n- subject: max 55 characters, no emoji, no exclamation marks\n- headline: max 70 characters\n- body: 60-110 words, plain text, ONE paragraph, no line breaks, no greeting, no sign-off\n- cta_label: 2-4 words, starts with a verb\n- Never include URLs, prices or claims that are not in the brief",
        "hasOutputParser": true,
        "batching": {
          "batchSize": 1,
          "delayBetweenBatches": 10000
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
