    {
      "parameters": {
        "jsCode": "// ---------- Scoring model: edit points and thresholds here ----------\nconst POINTS = {\n  industry:     { saas: 20, agency: 15, ecommerce: 10, finance: 10, other: 5 },\n  company_size: { '51-200': 15, '201-1000': 15, '11-50': 10, '1000+': 10, '1-10': 5 },\n  seniority:    { manager: 15, executive: 12, individual: 8 },\n  intent:       { high: 10, medium: 5 },\n};\nconst GRADE_A = 45;\nconst GRADE_B = 25;\nconst STAGES = ['lead', 'mql', 'customer'];   // lifecycle only moves forward\n\n// ---------- Inputs (one lead per run) ----------\nconst lead = $('Prepare lead').first().json;\nconst ai = $('Enrich lead').first().json.output;\nconst existing = $input.first().json;          // empty {} when the contact is new\n\n// ---------- Score ----------\nconst breakdown = {};\nfor (const key of Object.keys(POINTS)) breakdown[key] = POINTS[key][ai[key]] ?? 0;\nconst fit_score = Object.values(breakdown).reduce((sum, p) => sum + p, 0);\nconst grade = fit_score >= GRADE_A ? 'A' : fit_score >= GRADE_B ? 'B' : 'C';\n\n// ---------- Lifecycle: keep whichever stage is further along ----------\nconst isCustomer = String(existing.is_customer).toUpperCase() === 'TRUE';\nconst currentStage = isCustomer ? 'customer' : String(existing.lifecycle_stage || 'lead').toLowerCase();\nconst scoredStage = grade === 'A' ? 'mql' : 'lead';\nconst lifecycle_stage = STAGES[Math.max(STAGES.indexOf(currentStage), STAGES.indexOf(scoredStage))];\n\n// ---------- Consent: the form can grant it, never revoke it (unsubscribes do that) ----------\nconst optedIn = lead.consent === true || String(existing.opted_in).toUpperCase() === 'TRUE';\n\nreturn [{ json: {\n  email: lead.email,\n  first_name: lead.first_name,\n  language: lead.language,\n  segment: ai.segment,\n  lifecycle_stage,\n  is_customer: isCustomer ? 'TRUE' : 'FALSE',\n  opted_in: optedIn ? 'TRUE' : 'FALSE',\n  company: lead.domain,\n  industry: ai.industry,\n  company_size: ai.company_size,\n  seniority: ai.seniority,\n  intent: ai.intent,\n  company_summary: ai.company_summary,\n  fit_score,\n  score_breakdown: Object.entries(breakdown).map(([k, v]) => `${k} ${v}`).join(', '),\n  grade,\n  scored_at: new Date().toISOString(),\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
