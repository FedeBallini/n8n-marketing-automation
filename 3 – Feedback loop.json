        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(i => {\n  const j = i.json;\n  const sub = j.data ?? j.subscriber ?? j;\n  const email = String(sub.email || '').trim().toLowerCase();\n  const status = String(sub.status || '').toLowerCase();\n  const event = String(j.type || j.event || '').toLowerCase();\n  const today = new Date().toISOString().slice(0, 10);\n\n  const row = { email };\n  if (status === 'bounced' || event.includes('bounce')) {\n    row.bounced = 'TRUE';\n    row.status_log = `bounced (MailerLite) ${today}`;\n  } else if (status === 'junk' || event.includes('spam')) {\n    row.unsubscribed = 'TRUE';\n    row.status_log = `spam complaint (MailerLite) ${today}`;\n  } else {\n    row.unsubscribed = 'TRUE';\n    row.status_log = `unsubscribed (MailerLite) ${today}`;\n  }\n  return { json: row };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "57435154-2671-4072-9ed9-ac036da6e6b4",
